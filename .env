GESTAO_PEC_UPSTREAM=gestao-pec:8000
SIMPOSIO_INTEGRACAR_UPSTREAM=simposio-integracar:8000
PORTAL_INTEGRACAR_UPSTREAM=integracar-portal:80
CLASSIFICADOR_INTEGRACAR_UPSTREAM=frontend-classificador:80
INDEXADOR_FRONTEND_UPSTREAM=indexador-frontend:3000
INDEXADOR_API_UPSTREAM=indexador-backend:8000

# Caminho host dos PDFs
PDFS_HOST_PATH=/var/www/documentosCar
