INDEXADOR_API_DOMAIN=apiindexador.chatbotintegracar.online
FILES_DOMAIN=arquivos.chatbotintegracar.online

# Upstreams internos na rede Docker "proxy"
CHATBOT_INTEGRACAR_UPSTREAM=chatbot-integracar:8000
BERTCAR_FRONTEND_UPSTREAM=bertcar-frontend:3000
BERTCAR_BACKEND_UPSTREAM=bertcar-backend:8000
BERTCAR_BACKEND_OCR_UPSTREAM=bertcar-backend-ocr:8001
