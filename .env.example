# Domínios públicos
CHATBOT_INTEGRACAR_DOMAIN=chatbotintegracar.online
WORKSTATIONS_COLATINA_DOMAIN=workstations.chatbotintegracar.online
GESTAO_PEC_DOMAIN=pec.chatbotintegracar.online
SIMPOSIO_INTEGRACAR_DOMAIN=simposio.chatbotintegracar.online
CLASSIFICADOR_INTEGRACAR_DOMAIN=classificador.chatbotintegracar.online
FILES_DOMAIN=arquivos.chatbotintegracar.online

# Upstreams internos na rede Docker "proxy"
CHATBOT_INTEGRACAR_UPSTREAM=chatbot-integracar:8000
WORKSTATIONS_COLATINA_UPSTREAM=workstations-colatina:8000
GESTAO_PEC_UPSTREAM=gestao-pec:8000
SIMPOSIO_INTEGRACAR_UPSTREAM=simposio-integracar:8000
CLASSIFICADOR_INTEGRACAR_UPSTREAM=frontend-classificador:80

# Caminho host dos PDFs
PDFS_HOST_PATH=/var/www/documentosCar
